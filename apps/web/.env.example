# The only setting the web app reads.
#
# Server-side only: where the Next.js proxy (app/api/bff) reaches the FastAPI
# backend. The browser never sees this, and no secret belongs in this file: the
# Gemini key lives only in apps/api/.env, and sign-in sessions are httpOnly
# cookies issued by the API.
API_INTERNAL_URL=http://localhost:8000
