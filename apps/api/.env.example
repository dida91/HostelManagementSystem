# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Database (Docker pgvector on 5434; host PG 5432 and other project 5433 are in use) ---
DATABASE_URL=postgresql+asyncpg://hostel:hostel@localhost:5434/hostel
DATABASE_URL_SYNC=postgresql+psycopg://hostel:hostel@localhost:5434/hostel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Gemini (server-side only; NEVER expose to the browser) ---
GEMINI_API_KEY=your_key_here
# Verified working on a free-tier key (Sept 2026). gemini-2.5-* is retired for
# new keys, and pro models return 429 on the free tier.
# NOTE: the free tier allows only ~20 generate_content requests per day PER
# MODEL, so text and fast are deliberately different models to spread quota.
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Embeddings are FREE on the Gemini API free tier.
# gemini-embedding-001 is chosen over gemini-embedding-2 because it supports
# task_type (RETRIEVAL_DOCUMENT vs RETRIEVAL_QUERY). Asymmetric query/document
# embedding is one of the cheapest retrieval-quality wins available, and
# gemini-embedding-2 dropped the parameter. 001 is also cheaper ($0.15 vs
# $0.20 per 1M) if this ever moves off the free tier.
# Note: 001 caps input at 2048 tokens (embedding-2 allows 8192).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
# Report embedding cost as zero. Set false only on a paid key.
GEMINI_EMBEDDING_FREE_TIER=true
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_MAX_TOOL_ITERATIONS=5

# AI_REQUIRED=true -> startup FAILS if GEMINI_API_KEY is missing.
AI_REQUIRED=true
# Log full prompts/responses. Local debugging only; keep false elsewhere.
AI_LOG_PAYLOADS=false

# --- Uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520

# --- Hostel calendar & links ---
# "Today", due dates and scheduled jobs use the hostel's timezone, not the server's.
HOSTEL_TIMEZONE=Asia/Kathmandu
# Browser-facing web app origin, used for links in outbound email.
WEB_BASE_URL=http://localhost:3000

# --- Billing ---
# Monthly invoices (room rent + MONTHLY fee structures) are generated on the 1st.
AUTO_GENERATE_MONTHLY_INVOICES=true
INVOICE_DUE_DAY=10
FEE_REMINDER_DAYS_BEFORE_DUE=3

# --- Email (optional) ---
# Leave SMTP_HOST empty to disable email; in-app notifications still work.
# Local testing with a mail catcher such as Mailpit (smtp :1025, web UI :8025):
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURITY=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls | ssl | none   (none is refused when APP_ENV=production)
SMTP_SECURITY=starttls
EMAIL_FROM=Kutumba Hostel <no-reply@example.com>

# --- SMS (optional; costs money per message) ---
# none | sparrow. Sparrow SMS (Nepal) needs a token and an approved sender id.
# Only leave decisions, fee reminders and overdue notices are sent by SMS.
SMS_PROVIDER=none
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# --- Reports ---
# A Devanagari TTF so Nepali text prints correctly in PDF exports
# (Debian/Ubuntu: apt install fonts-noto-core).
REPORT_DEVANAGARI_FONT=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf
