# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------

APP_ENV=local
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Database (Docker pgvector on 5434; host PG 5432 and other project 5433 are in use) ---
DATABASE_URL=postgresql+asyncpg://hostel:hostel@localhost:5434/hostel
DATABASE_URL_SYNC=postgresql+psycopg://hostel:hostel@localhost:5434/hostel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Gemini (server-side only; NEVER expose to the browser) ---
GEMINI_API_KEY=your_key_here
GEMINI_TEXT_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=3
GEMINI_MAX_TOOL_ITERATIONS=5

# AI_REQUIRED=true -> startup FAILS if GEMINI_API_KEY is missing.
AI_REQUIRED=true
# Log full prompts/responses. Local debugging only; keep false elsewhere.
AI_LOG_PAYLOADS=false

# --- Uploads ---
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520
